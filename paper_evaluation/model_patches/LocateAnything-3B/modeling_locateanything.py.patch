+        def _sample_parallel_geometry_wave(generated, outputs, wave_size):
+            """Decode one learned wave and serialize accepted native PBD6 boxes."""
+            next_token_logits = outputs.logits[:, -n_future_tokens:, :]
+            probs, confidence, x0, box_avg = sample_tokens(
+                next_token_logits,
+                generated.expand(wave_size, -1),
+                self.token_ids,
+                keep_k=5,
+                **generate_kwargs,
+            )
+            del probs, confidence
+            accepted_tokens = []
+            accepted_indices = []
+            seen = set()
+            fallback = None
+            for branch in range(wave_size):
+                is_box_empty = (box_avg[branch] == 0).all()
+                candidate = x0[branch] if is_box_empty else box_avg[branch]
+                pattern = handle_pattern(candidate, self.token_ids, generation_mode)
+                token = torch.tensor(
+                    pattern['tokens'], dtype=x0.dtype, device=x0.device
+                )
+                if branch == 0:
+                    fallback = (pattern['type'], token)
+                if pattern['type'] != 'coord_box':
+                    continue
+                identity = tuple(int(value) for value in token.tolist())
+                if identity in seen:
+                    continue
+                seen.add(identity)
+                accepted_indices.append(branch)
+                accepted_tokens.append(token)
+            if accepted_tokens:
+                return (
+                    'coord_box',
+                    torch.cat(accepted_tokens, dim=0),
+                    accepted_indices,
+                )
+            if fallback is None:
+                raise RuntimeError('Adaptive PIVR wave produced no decodable branch')
+            return fallback[0], fallback[1], []
+
+
+        def _coord_token_to_value(token):
+            coord_start_token_id = self.token_ids['coord_start_token_id']
+            coord_end_token_id = self.token_ids['coord_end_token_id']
+            token_val = int(token.item() if hasattr(token, "item") else token)
+            if coord_start_token_id <= token_val <= coord_end_token_id:
+                return token_val - coord_start_token_id
+            return None
+
+
+        def _point_inside_box_tokens(point_token, box_token):
+            if point_token is None or box_token is None or len(point_token) < 4 or len(box_token) < 6:
+                return None
+            px = _coord_token_to_value(point_token[1])
+            py = _coord_token_to_value(point_token[2])
+            x1 = _coord_token_to_value(box_token[1])
+            y1 = _coord_token_to_value(box_token[2])
+            x2 = _coord_token_to_value(box_token[3])
+            y2 = _coord_token_to_value(box_token[4])
+            if None in (px, py, x1, y1, x2, y2):
+                return None
+            left, right = sorted((x1, x2))
+            top, bottom = sorted((y1, y2))
+            return left <= px <= right and top <= py <= bottom
+
+
+        def _record_pbda_block(out_type, out_token, block_scores=None):
+            nonlocal pending_point_token
+            if block_scores is not None and generate_kwargs.get('pbda_log_scores', False):
+                pbda_stats["block_scores"].append(block_scores)
+            if out_type == 'ref_object':
+                pbda_stats["semantic_blocks"] += 1
+            elif out_type == 'coord_box':
+                pbda_stats["box_blocks"] += 1
+                if pending_point_token is not None:
+                    pbda_stats["point_to_box_refinements"] += 1
+                    inside = _point_inside_box_tokens(pending_point_token, out_token)
+                    if inside is False:
+                        pbda_stats["inconsistent_point_box_pairs"] += 1
+                    pending_point_token = None
+            elif out_type == 'point_box':
+                pbda_stats["point_blocks"] += 1
+                pending_point_token = out_token.detach().clone()
+            elif out_type == 'empty_box':
+                pbda_stats["negative_blocks"] += 1
+            elif out_type == 'im_end':
+                pbda_stats["end_blocks"] += 1
+
+
+        def _sample_token_in_pbda(generated, outputs):
+            """PBDA policy over the same 6-token PBD window used by baseline."""
+            next_token_logits = outputs.logits[:, -n_future_tokens:, :]
+            localization_controller = getattr(
+                self, '_pivr_generation_controller', None
+            )
+            if (
+                localization_controller is not None
+                and hasattr(localization_controller, 'adjust_pbd_logits')
+            ):
+                next_token_logits = localization_controller.adjust_pbd_logits(
+                    next_token_logits
+                )
+            probs, confidence, x0, box_avg = sample_tokens(
+                next_token_logits, generated, self.token_ids, keep_k=5, **generate_kwargs
+            )
+
+            is_box_empty = (box_avg[0] == 0).all()
+            baseline_tokens = x0[0] if is_box_empty else box_avg[0]
+            baseline_pattern = handle_pattern(baseline_tokens, self.token_ids, generation_mode)
+            baseline_type = baseline_pattern['type']
+            baseline_token = torch.tensor(baseline_pattern['tokens'], dtype=x0.dtype, device=x0.device)
+
+            block_scores = score_pbd_blocks(
+                probs[0],
+                self.token_ids,
+                keep_k=generate_kwargs.get('keep_k_avg', 4),
+            )
+            end_margin = float(generate_kwargs.get('end_margin', 0.10))
+            neg_margin = float(generate_kwargs.get('neg_margin', 0.10))
+            min_point_conf = float(generate_kwargs.get('min_point_conf', 0.20))
+            min_box_conf = float(generate_kwargs.get('min_box_conf', 0.20))
+            max_boxes = int(generate_kwargs.get('max_boxes', 1000000))
+            max_point_box_pairs = int(generate_kwargs.get('max_point_box_pairs', 1000000))
+
+            if pbda_stats["box_blocks"] >= max_boxes:
+                out_token = torch.tensor([self.token_ids['im_end_token_id']], dtype=x0.dtype, device=x0.device)
+                _record_pbda_block('im_end', out_token, block_scores)
+                return 'im_end', out_token
+
+            # Preserve semantic/ref generation; PBDA should not invent labels.
+            if baseline_type == 'ref_object':
+                _record_pbda_block(baseline_type, baseline_token, block_scores)
+                return baseline_type, baseline_token
+
+            max_continue = max(block_scores["point"], block_scores["box"], block_scores["semantic"])
+            max_localize = max(block_scores["point"], block_scores["box"])
+
+            if baseline_type == 'im_end':
+                if block_scores["end"] - max_continue > end_margin:
+                    pbda_stats["end_accepted_immediately"] += 1
+                    _record_pbda_block(baseline_type, baseline_token, block_scores)
+                    return baseline_type, baseline_token
+                pbda_stats["end_delayed"] += 1
+
+            if baseline_type == 'empty_box':
+                if block_scores["negative"] - max_localize > neg_margin:
+                    pbda_stats["negative_accepted_immediately"] += 1
+                    _record_pbda_block(baseline_type, baseline_token, block_scores)
+                    return baseline_type, baseline_token
+                pbda_stats["negative_delayed"] += 1
+
+            if (not is_box_empty) and block_scores["box"] >= min_box_conf:
+                box_pattern = handle_pattern(box_avg[0], self.token_ids, generation_mode)
+                if box_pattern["type"] == "coord_box":
+                    out_token = torch.tensor(box_pattern['tokens'], dtype=x0.dtype, device=x0.device)
+                    _record_pbda_block('coord_box', out_token, block_scores)
+                    return 'coord_box', out_token
+
+            if (
+                block_scores["point"] >= min_point_conf
+                and block_scores["point"] >= block_scores["box"]
+                and pbda_stats["point_to_box_refinements"] + pbda_stats["point_blocks"] < max_point_box_pairs
+            ):
+                point_token = decode_point_avg(
+                    next_token_logits[0],
+                    probs[0],
+                    self.token_ids,
+                    keep_k=generate_kwargs.get('keep_k_avg', 4),
+                    start_thresh=generate_kwargs.get('point_start_thresh', 0.25),
+                    end_thresh=generate_kwargs.get('point_end_thresh', 0.10),
+                )
+                if point_token is not None:
+                    out_pattern = handle_pattern(point_token, self.token_ids, generation_mode)
+                    if out_pattern["type"] == "point_box":
+                        out_token = torch.tensor(out_pattern['tokens'], dtype=x0.dtype, device=x0.device)
+                        _record_pbda_block('point_box', out_token, block_scores)
+                        return 'point_box', out_token
+
+            # If End/None was delayed but no usable point/box exists, continue with
+            # the baseline decision to avoid non-terminating loops.
+            _record_pbda_block(baseline_type, baseline_token, block_scores)
+            return baseline_type, baseline_token
+
